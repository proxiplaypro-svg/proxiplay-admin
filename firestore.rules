rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in [
          "proxiplay.pro@gmail.com"
        ];
    }

    function hasAdminClaim() {
      return isSignedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function signedInEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : null;
    }

    function ownsEnseigneById(merchantId) {
      return merchantId != null
        && signedInEmail() != null
        && exists(/databases/$(database)/documents/enseignes/$(merchantId))
        && get(/databases/$(database)/documents/enseignes/$(merchantId)).data.get('managed_by_admin', false) != true
        && get(/databases/$(database)/documents/enseignes/$(merchantId)).data.email == signedInEmail();
    }

    function ownsMerchantById(merchantId) {
      return merchantId != null
        && signedInEmail() != null
        && exists(/databases/$(database)/documents/merchants/$(merchantId))
        && get(/databases/$(database)/documents/merchants/$(merchantId)).data.get('managed_by_admin', false) != true
        && get(/databases/$(database)/documents/merchants/$(merchantId)).data.email == signedInEmail();
    }

    function canManageShopReference(shopRef) {
      return shopRef is path && exists(shopRef)
        && get(shopRef).data.get('managed_by_admin', false) != true
        && get(shopRef).data.get('email', '') == signedInEmail();
    }

    function canManageGameAsMerchant(data) {
      let shopRef = data.get('enseigne_id', null);
      let merchantId = data.get('merchantId', data.get('merchant_id', null));
      return isSignedIn() && (shopRef != null
        ? canManageShopReference(shopRef)
        : (merchantId != null && exists(/databases/$(database)/documents/enseignes/$(merchantId))
          ? ownsEnseigneById(merchantId) : ownsMerchantById(merchantId)));
    }

    function isCurrentUser(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isPublicGame() {
      return resource.data.visible_public == true
        || resource.data.visiblePublic == true;
    }

    // Support collectionGroup reads used by the live app for winner-related subcollections.
    match /{path=**}/instant_winners/{winnerId} {
      allow read: if true;
      allow write: if false;
    }

    match /{path=**}/participants/{participantId} {
      allow read: if true;
    }

    // Prospection is only accessed through authenticated admin server routes.
    // Deny direct SDK access, including writes that would bypass deduplication/history.
    match /prospects/{document=**} {
      allow read, write: if false;
    }
    match /prospection_internal/{document=**} {
      allow read, write: if false;
    }

    match /admin_stats/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /enseignes/{merchantId} {
      allow read: if hasAdminClaim() || isSignedIn();
      allow create, delete: if isAdmin() || hasAdminClaim();
      allow update: if isAdmin() || hasAdminClaim() || (isSignedIn()
        && resource.data.get('managed_by_admin', false) != true
        && resource.data.email == signedInEmail()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['owner', 'owner_id', 'email', 'status', 'managed_by_admin']));
    }

    // Preserve legacy subcollection access without permitting parent ownership changes.
    match /enseignes/{merchantId}/{subcollection}/{document=**} {
      allow read: if hasAdminClaim() || isSignedIn();
      allow write: if isAdmin() || hasAdminClaim() || (isSignedIn()
        && get(/databases/$(database)/documents/enseignes/$(merchantId)).data.get('managed_by_admin', false) != true);
    }

    match /merchants/{document=**} {
      allow read: if hasAdminClaim() || isSignedIn();
      allow write: if hasAdminClaim() || isSignedIn();
    }

    match /games/{gameId} {
      allow read: if hasAdminClaim() || isPublicGame() || isSignedIn();
      allow create: if isAdmin() || hasAdminClaim() || canManageGameAsMerchant(request.resource.data);
      allow update: if isAdmin() || hasAdminClaim() || (canManageGameAsMerchant(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enseigne_id', 'merchantId', 'merchant_id', 'owner_id']));
      allow delete: if isAdmin() || hasAdminClaim() || canManageGameAsMerchant(resource.data);

      match /instant_winners/{winnerId} {
        allow read: if true;
        allow write: if false;
      }

      match /participants/{participantId} {
        // Public pages still resolve winner display from participant documents.
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if hasAdminClaim();
      }
    }

    match /jeux/{gameId} {
      allow read: if hasAdminClaim() || isPublicGame() || isSignedIn();
      allow create: if isAdmin() || hasAdminClaim() || canManageGameAsMerchant(request.resource.data);
      allow update: if isAdmin() || hasAdminClaim() || (canManageGameAsMerchant(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enseigne_id', 'merchantId', 'merchant_id', 'owner_id']));
      allow delete: if isAdmin() || hasAdminClaim() || canManageGameAsMerchant(resource.data);

      match /instant_winners/{winnerId} {
        allow read: if true;
        allow write: if false;
      }

      match /participants/{participantId} {
        // Public pages still resolve winner display from participant documents.
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if hasAdminClaim();
      }
    }

    match /users/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId}/fcm_tokens/{tokenId} {
      allow read: if isAdmin() || isCurrentUser(userId);
      allow write: if isCurrentUser(userId);
    }

    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if isAdmin() || isCurrentUser(userId);
    }

    match /users/{userId}/favoris/{favoriteId} {
      allow read, write: if isAdmin() || isCurrentUser(userId);
    }

    match /users/{userId}/{subcollection}/{document=**} {
      allow read, write: if isAdmin() || isCurrentUser(userId);
    }

    match /users/{userId} {
      // The live app also renders winners on the public home.
      // Keep nested user data protected while allowing top-level profile reads.
      allow read: if isAdmin() || isCurrentUser(userId) || true;
      // Privileged account state is managed by the authenticated admin API.
      allow create: if isAdmin() || (isCurrentUser(userId)
        && (!('user_role' in request.resource.data) || request.resource.data.user_role == 'joueur'));
      allow update: if isAdmin() || (isCurrentUser(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['user_role', 'account_status']));
      allow delete: if isAdmin() || isCurrentUser(userId);
    }

    match /favorites/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /favoris/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /prizes/{document=**} {
      // Public winner banners rely on reading prize documents without auth.
      allow read: if true;
      allow write: if false;
    }

    match /animations/{animationId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /entries/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // ecriture reservee au backend
      }
    }

    match /ff_push_notifications/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
