{
  "name": "proxiplay-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:prospection": "tsx --test prospection.test.ts prospection-artisans.test.ts",
    "test:prospection-email": "node --test functions/test/prospect_email.test.cjs functions/test/prospect_proposal.test.cjs",
    "test:prospection-email-ui": "node --test prospection-email-ui.test.mjs",
    "test:prospection-bulk-ui": "node --test prospection-bulk-ui.test.mjs",
    "test:prospection-bulk-api": "firebase emulators:exec --project demo-prospection --only firestore,auth \"node --test functions/test/prospect_bulk_emulator.test.cjs\"",
    "test:prospection-email-list": "tsx --test prospection-email-list.test.ts && node --test prospection-email-list-ui.test.mjs",
    "test:prospection-email-api": "firebase emulators:exec --project demo-prospection --only firestore,auth \"node --test functions/test/prospect_email_emulator.test.cjs\"",
    "test:prospection-api": "firebase emulators:exec --project demo-prospection --only firestore,auth \"tsx --test prospection-api.test.ts\"",
    "test:admin-merchants": "firebase emulators:exec --project demo-admin-merchants --only firestore,auth \"tsx --test merchant-admin.test.ts\"",
    "test:merchant-media": "tsx --test merchant-media.test.ts && node --test merchant-media-ui.test.mjs",
    "test:merchant-media-api": "firebase emulators:exec --project demo-admin-merchants --only firestore,auth \"tsx --test --test-concurrency=1 merchant-admin.test.ts merchant-photos-api.test.ts\"",
    "test:merchant-emails": "node --test functions/test/managed_merchant_email.test.cjs",
    "test:firestore-managed-by-admin": "firebase emulators:exec --project demo-admin-merchants-rules --only firestore,auth \"tsx --test firestore-managed-by-admin.test.ts\"",
    "test:admin-api": "firebase emulators:exec --only firestore,auth \"tsx --test referral-games-api.test.ts\"",
    "test:admin-qr": "firebase emulators:exec --project demo-admin-qr --only firestore,auth \"tsx --test secure-game-qr.test.ts\""
  },
  "dependencies": {
    "@sparticuz/chromium-min": "^147.0.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^12.7.0",
    "jspdf": "^4.2.1",
    "next": "16.2.2",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
